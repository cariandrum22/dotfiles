{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/bash",
  "enabled_providers": [
    "llamacpp"
  ],
  "model": "llamacpp/local",
  "providers": {
    "llamacpp": {
      "name": "Laboratory llama.cpp",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{file:~/.config/opencode/local-model/base-url}",
        "timeout": 900000
      },
      "models": {
        "local": {
          "modelID": "{file:~/.config/opencode/local-model/model-id}",
          "name": "{file:~/.config/opencode/local-model/name}",
          "capabilities": {
            "tools": true,
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  },
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "*",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "llamacpp",
        "effect": "allow"
      }
    ]
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask"
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git diff *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "pytest *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "python -m pytest *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "uv run pytest *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git reset --hard *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "sudo *",
      "effect": "deny"
    }
  ],
  "agents": {
    "build": {
      "steps": 96,
      "permissions": [
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "title": {
      "disabled": true
    }
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 24000
    },
    "buffer": 16384
  }
}
