{
  "mcpServers": {
    "awslabs_aws-documentation-mcp-server": {
      "args": [
        "awslabs.aws-documentation-mcp-server==1.2.2"
      ],
      "command": "uvx",
      "env": {
        "AWS_DOCUMENTATION_PARTITION": "aws",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "brave-search": {
      "command": "bash",
      "args": [
        "-lc",
        "CONFIG_HOME=\"${XDG_CONFIG_HOME:-$HOME/.config}\"; exec \"$CONFIG_HOME/claudius/bin/mcp-with-credentials\" --server brave-search -- npx -y @brave/brave-search-mcp-server@2.1.4 --transport stdio"
      ],
      "env": {
        "BRAVE_MCP_ENABLED_TOOLS": "brave_web_search brave_news_search brave_image_search brave_video_search brave_local_search"
      }
    },
    "chrome-devtools": {
      "args": [
        "-y",
        "chrome-devtools-mcp@1.10.1",
        "--isolated",
        "--no-usage-statistics",
        "--no-performance-crux",
        "--no-javascript-evaluation",
        "--redact-network-headers"
      ],
      "command": "npx",
      "env": {}
    },
    "figma": {
      "args": [],
      "env": {},
      "url": "https://mcp.figma.com/mcp",
      "type": "http"
    },
    "github": {
      "args": [
        "-lc",
        "CONFIG_HOME=\"${XDG_CONFIG_HOME:-$HOME/.config}\"; exec \"$CONFIG_HOME/claudius/bin/mcp-with-credentials\" --server github -- github-mcp-server stdio --lockdown-mode"
      ],
      "command": "bash",
      "env": {}
    },
    "google-calendar": {
      "args": [
        "-lc",
        "CONFIG_HOME=\"${XDG_CONFIG_HOME:-$HOME/.config}\"; exec \"$CONFIG_HOME/claudius/bin/mcp-with-credentials\" --server google-workspace -- \"$CONFIG_HOME/claudius/bin/mcp-google-workspace\" calendar"
      ],
      "command": "bash",
      "env": {},
      "startup_timeout_sec": 300
    },
    "google-drive": {
      "args": [
        "-lc",
        "CONFIG_HOME=\"${XDG_CONFIG_HOME:-$HOME/.config}\"; exec \"$CONFIG_HOME/claudius/bin/mcp-with-credentials\" --server google-workspace -- \"$CONFIG_HOME/claudius/bin/mcp-google-workspace\" drive"
      ],
      "command": "bash",
      "env": {},
      "startup_timeout_sec": 300
    },
    "google-gmail": {
      "args": [
        "-lc",
        "CONFIG_HOME=\"${XDG_CONFIG_HOME:-$HOME/.config}\"; exec \"$CONFIG_HOME/claudius/bin/mcp-with-credentials\" --server google-workspace -- \"$CONFIG_HOME/claudius/bin/mcp-google-workspace\" gmail"
      ],
      "command": "bash",
      "env": {},
      "startup_timeout_sec": 300
    },
    "notion": {
      "args": [],
      "env": {},
      "url": "https://mcp.notion.com/mcp",
      "type": "http"
    },
    "playwright": {
      "args": [
        "-y",
        "@playwright/mcp@0.0.83",
        "--isolated",
        "--no-webmcp"
      ],
      "command": "npx",
      "env": {}
    },
    "todoist": {
      "args": [],
      "env": {},
      "url": "https://ai.todoist.net/mcp",
      "type": "http"
    },
    "x": {
      "args": [
        "-lc",
        "CONFIG_HOME=\"${XDG_CONFIG_HOME:-$HOME/.config}\"; exec \"$CONFIG_HOME/claudius/bin/mcp-with-credentials\" --server x -- npx -y @xdevplatform/xurl@1.3.4 mcp https://api.x.com/mcp"
      ],
      "command": "bash",
      "env": {},
      "startup_timeout_sec": 300
    }
  }
}
